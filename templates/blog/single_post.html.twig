{% extends 'base.html.twig' %}

{% block title %}Single Post{% endblock %}

{% block body %}
    <!-- Principal Content Start -->
   <div id="single">
      <div class="container">
      {% if not post %}
          <h2>Post not found</h2>
      {% else %}
        <!-- Full Article -->
          <div class="row">
          <h2>{{ post.title }}</h2>
          <hr class="subtitle">
          <div class=" block1">
          <div class="col-xs-12 col-sm-9">
            <img class="img-responsive" src="{{ asset('images/blog/' ~ post.image) }}" alt="post's picture" style="margin-bottom: 20px; max-width: 100%;">
            <p>{{ post.content | nl2br }}</p>
            <h4>- By {{ post.postUser ? post.postUser.name : 'Anónimo' }}</h4> <!-- si no tiene autor, muestra 'Anónimo' -->
            <hr>
            <ul class="list-inline">
              <li>{{ post.publishedAt | date('d') }} {{ post.publishedAt | date('F') }} |</li>
              <!-- Enlaces para comentar y dar like --> 
              <li><a class="page-scroll" href="#form">COMMENT</a> <i class="fa fa-comments sr-icons"></i> {{post.numComments}} |</li>
              <li><a href="{{ path('post_like', {slug: post.slug}) }}">LIKE</a> <i class="fa fa-heart sr-icons"></i> {{post.numLikes}}</li>
            </ul>
          </div>
          <div class="col-xs-12 col-sm-3">
            <h4>Recent Post</h4>
            <hr class="subtitle1">
            {% for recent in recents %}
                {{ include ('partials/_recent_post.html.twig', {'recent': recent}) }}
            {% endfor %}
          </div>
          </div>
          </div>
        <!-- End of Full Article -->

        <!-- Comments -->
          <div class="row">
          <div class="col-xs-12 col-sm-12 block2">
            <!-- Mostramos los comentarios  -->
            {% for comment in post.comments %}
                {{ include ('partials/_comment.html.twig', {'comment': comment}) }}
            {% endfor %}
            <!-- Formulario de comentarios -->
              <hr class="line">
               {{ include ('partials/_post_comments.html.twig') }}
          </div>
          </div>
        <!-- End of Comments -->
      {% endif %}
      </div>
   </div>
    <!-- End of Principal Content Start -->    
{% endblock %}